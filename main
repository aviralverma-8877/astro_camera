#!/usr/bin/env python3

from Functions import Functions
from logging_config import setup_logging
import os
import signal
import threading

# Setup logging
logger = setup_logging()

# Create shutdown event for efficient waiting
shutdown_event = threading.Event()

def signal_handler(sig, frame):
    """Handle shutdown signals gracefully"""
    logger.info(f"Shutdown signal received ({sig})")
    shutdown_event.set()

# Register signal handlers
signal.signal(signal.SIGINT, signal_handler)
signal.signal(signal.SIGTERM, signal_handler)

logger.info("Astro Camera starting...")

# Initialize system
main_dir = os.path.dirname(os.path.abspath(__file__))
func = Functions()
func.init_system(main_dir)
func.setup_buttons()

# Wait for shutdown signal (efficient, <1% CPU)
logger.info("System ready - waiting for events")
shutdown_event.wait()

# Cleanup
logger.info("Shutting down...")
try:
    if hasattr(func, 'cleanup'):
        func.cleanup()
except Exception as e:
    logger.error(f"Error during cleanup: {e}")

logger.info("Shutdown complete")