#!/bin/bash
set -e

# Pre-removal script for astro-camera

echo "Stopping Astro Camera service..."

# Stop and disable the service
if systemctl is-active --quiet astro_cam.service; then
    systemctl stop astro_cam.service || true
fi

if systemctl is-enabled --quiet astro_cam.service; then
    systemctl disable astro_cam.service || true
fi

echo "Astro Camera service stopped."

exit 0
